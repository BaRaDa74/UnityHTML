html, body {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 100%;
}

body {
    -unity-font: url("project://database/Assets/Fonts/Rubik-Regular.ttf");
    font-size: 16px;
    color: #e8edf7;
    background-color: #0b1020;
}

.screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-top: 32px;
    padding-right: 48px;
    padding-bottom: 32px;
    padding-left: 48px;
    background-color: #0b1020;
}

.topbar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(30, 41, 66, 0.55);
}

.brand {
    display: flex;
    flex-direction: column;
}

.game-title {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.tagline {
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.build-stamp {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.build-id {
    -unity-font: url("project://database/Assets/Fonts/SpaceMono-Regular.ttf");
    font-size: 13px;
    -unity-font-style: normal;
    color: #4cc9f0;
}

.build-time {
    font-size: 12px;
    color: #8b98b4;
}

.content {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    padding-top: 40px;
    padding-right: 0;
    padding-bottom: 40px;
    padding-left: 0;
}

.hero {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 55%;
    margin-right: 32px;
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
}

.hero-heading {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 12px;
    margin-left: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.hero-copy {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 32px;
    margin-left: 0;
    font-size: 16px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.highlight {
    color: #ffb703;
    -unity-font-style: bold;
}

.progress-block {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 420px;
    margin-bottom: 32px;
}

.progress-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.progress-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: #4cc9f0;
}

progress {
    width: 100%;
    height: 12px;
}

.tip {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-right: 16px;
    padding-bottom: 12px;
    padding-left: 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgba(30, 41, 66, 0.55);
    background-repeat: no-repeat;
}

.tip-icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    -unity-text-align: middle-center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: #4cc9f0;
    color: #0b1020;
    font-size: 12px;
    -unity-font-style: bold;
}

.tip-copy {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.panel {
    display: flex;
    flex-direction: column;
    width: 40%;
    min-width: 380px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-width: 1px;
    border-color: #223052;
    background-color: rgba(14, 20, 38, 0.92);
}

.divider {
    height: 1px;
    width: 100%;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    background-color: #223052;
}

.overlay-screen {
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 16, 0.78);
}

.pause-panel {
    display: flex;
    flex-direction: column;
    width: 72%;
    max-width: 920px;
    min-width: 720px;
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    background-color: rgba(14, 20, 38, 0.92);
}

.pause-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
}

.pause-heading {
    display: flex;
    flex-direction: column;
}

.pause-title {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.pause-subtitle {
    margin-top: 6px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.pause-body {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
}

.pause-nav {
    display: flex;
    flex-direction: column;
    width: 46%;
    margin-right: 32px;
}

.pause-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.stat-list {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
}

.stat-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: rgba(30, 41, 66, 0.55);
}

.stat-term {
    font-size: 13px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: #e8edf7;
}

.pause-figure {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(30, 41, 66, 0.55);
}

.quote {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    font-size: 15px;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.quote-source {
    font-size: 12px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.rule {
    height: 1px;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    border-width: 0;
    background-color: #223052;
}

.quick-audio {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(30, 41, 66, 0.55);
}

.quick-audio-legend {
    padding-top: 0;
    padding-right: 8px;
    padding-bottom: 0;
    padding-left: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.pause-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.pause-footer-links {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.settings-screen {
    align-items: center;
    justify-content: center;
}

.settings-panel {
    display: flex;
    flex-direction: column;
    width: 82%;
    max-width: 1080px;
    min-height: 660px;
    padding-top: 28px;
    padding-right: 32px;
    padding-bottom: 28px;
    padding-left: 32px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    background-color: rgba(14, 20, 38, 0.92);
}

.settings-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
}

.back-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
    font-size: 14px;
}

.settings-heading {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 32px;
    margin-bottom: 0;
    margin-left: 32px;
}

.settings-title {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.settings-subtitle {
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.settings-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
}

.settings-sidebar {
    display: flex;
    flex-direction: column;
    width: 34%;
    min-width: 240px;
    margin-right: 32px;
}

.settings-note {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.settings-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    max-height: 440px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    overflow: hidden;
}

.setting-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: rgba(30, 41, 66, 0.55);
}

.setting-text {
    display: flex;
    flex-direction: column;
    margin-right: 24px;
}

.setting-label {
    font-size: 14px;
    -unity-text-align: middle-left;
    color: #e8edf7;
}

.setting-hint {
    margin-top: 2px;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.setting-control {
    width: 220px;
}

.settings-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.legal {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.legal small {
    font-size: 12px;
    color: #8b98b4;
}

.footer-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
}

