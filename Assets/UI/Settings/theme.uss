.menu-nav {
    display: flex;
    flex-direction: column;
}

.menu-list {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.menu-row {
    margin-bottom: 8px;
}

.menu-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 12px;
    padding-right: 16px;
    padding-bottom: 12px;
    padding-left: 16px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: #e8edf7;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.menu-item:hover {
    border-color: #4cc9f0;
    background-color: rgba(30, 41, 66, 0.55);
    color: #4cc9f0;
}

.menu-item:active {
    background-color: rgba(76, 201, 240, 0.18);
    color: #2a9dc4;
}

.menu-item:focus {
    border-color: #4cc9f0;
    --unity-shadow-offset-x: 0;
    --unity-shadow-offset-y: 0;
    --unity-shadow-blur-radius: 0;
    --unity-shadow-color: rgba(76, 201, 240, 0.55);
}

.menu-item.is-primary {
    border-color: #4cc9f0;
    background-color: rgba(76, 201, 240, 0.12);
    --unity-shadow-offset-x: 0;
    --unity-shadow-offset-y: 4px;
    --unity-shadow-blur-radius: 12px;
    --unity-shadow-color: rgba(0, 0, 0, 0.45);
}

.menu-item.is-danger {
    color: #ff5c7c;
}

.menu-item.is-danger:hover {
    border-color: #ff5c7c;
    background-color: rgba(255, 92, 124, 0.12);
    color: #ff5c7c;
}

.menu-label {
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.menu-hint {
    margin-top: 2px;
    font-size: 12px;
    -unity-font-style: normal;
    letter-spacing: 0px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.section-heading {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 16px;
    margin-left: 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    color: #8b98b4;
}

.field {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
}

.field-inline {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.field-label {
    margin-bottom: 6px;
    font-size: 13px;
    color: #8b98b4;
}

.field-input, .field-select, .field-number {
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    border-width: 1px;
    border-color: #223052;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: rgba(30, 41, 66, 0.55);
    color: #e8edf7;
    font-size: 14px;
}

.field-input:focus, .field-select:focus, .field-number:focus {
    border-color: #4cc9f0;
    color: #e8edf7;
}

.field-slider {
    width: 100%;
    height: 16px;
}

.radio-group {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.radio-input {
    margin-right: 6px;
}

.radio-label {
    margin-right: 14px;
    font-size: 13px;
    color: #8b98b4;
}

.toggle-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding-top: 12px;
    padding-right: 16px;
    padding-bottom: 12px;
    padding-left: 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: rgba(30, 41, 66, 0.55);
}

.toggle-input {
    margin-right: 6px;
}

.toggle-label {
    margin-right: 16px;
    font-size: 13px;
    color: #e8edf7;
}

.button-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.button {
    margin-right: 12px;
    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 10px;
    padding-left: 20px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.button-primary {
    background-color: #4cc9f0;
    color: #0b1020;
}

.button-primary:hover {
    background-color: #2a9dc4;
}

.button-primary:active {
    background-color: #1d7e9f;
}

.button-ghost {
    border-color: #223052;
    background-color: transparent;
    color: #8b98b4;
}

.button-ghost:hover {
    border-color: #4cc9f0;
    color: #4cc9f0;
}

.link {
    margin-right: 12px;
    font-size: 13px;
    color: #4cc9f0;
    -unity-text-align: middle-left;
}

.link:hover {
    color: #e8edf7;
}

.link-muted {
    margin-right: 20px;
    color: #8b98b4;
}

.link-muted:hover {
    color: #4cc9f0;
}

.legal {
    color: #8b98b4;
}

